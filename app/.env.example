# Copy to app/.env for local development. Never commit real credentials.
ENVIRONMENT=development
DEBUG=false
APP_NAME=DesignBook - RCC Structural Design
APP_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://designbook:designbook@localhost:5432/designbook
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Replace for any shared/staging/production environment.
SECRET_KEY=local-development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DESIGN_EXCEL_DIR=../doc-files/design-excel
ENHANCED_EXCEL_DIR=../doc-files/design-excel/enhanced
REGULATIONS_DIR=../doc-files/regulations

# Keep false until an Alembic migration workflow is in place.
CREATE_SCHEMA_ON_STARTUP=false
